generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
}



//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserRole {
   ADMIN
  USER
  SELLER
  MODERATOR
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum SlugModel {
  PRODUCT
  CATEGORY
  SUBCATEGORY
  MARKET
}

enum Language {
  EN
  HI
  MR
  TA
  TE
  KN
  GU
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String?
  role      UserRole @default(USER)

  products   Product[]
  orders     Order[]
  orderItems OrderItem[]
  sales      Sale[]
  coupons    Coupon[]

  Profile   UserProfile?
  sellerProfile SellerProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  name        String?
  firstName   String?
  lastName    String?
  email       String?
  username    String?
  phone       String?
  streetAddress String?
  city        String?
  country     String?
  district    String?
  dateOfBirth DateTime?
  profileImage String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
   id                 String @id @default(uuid())
  userId             String @unique
  code               String?
  contactPerson      String?
  contactPersonPhone String?
  profileImageUrl    String?
  firstName          String?
  lastName           String?
  notes              String?
  phone              String?
  physicalAddress    String?
  terms              String?
  isActive           Boolean?
  products           String[]
  landSize           Float?
  mainCrop           String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// CATEGORY + MARKET
//////////////////////////////////////////////////////

model Category {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  imageUrl    String?
  description String?
  isActive    Boolean  @default(true)

  subCategories SubCategory[]
  products      Product[]
 

  markets Market[] @relation("MarketCategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategory {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  imageUrl    String
  description String
  isActive    Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Market {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  logoUrl     String?
  description String?
  isActive    Boolean @default(true)

  categories Category[] @relation("MarketCategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// GST + HSN
//////////////////////////////////////////////////////

model GstSetting {
  id       String  @id @default(uuid())
  name     String
  cgst     Float
  sgst     Float
  igst     Float
  isActive Boolean @default(true)
products Product[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HsnCode {
  id          String  @id @default(uuid())
  code        String  @unique
  description String
  gstRate     Float
  cessRate    Float?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// PRODUCT
//////////////////////////////////////////////////////

model Product {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  imageUrl       String?
  productImages  String[]
  description    String?
  isActive       Boolean  @default(true)
  isWholesale    Boolean  @default(false)

  sku            String?
  barcode        String? @unique
  qrCode         String? @unique
  productCode    String?
  unit           String?

  productPrice   Float
  salePrice      Float
  wholesalePrice Float?
  wholesaleQty   Int?

  productStock   Int?
  tags           String[]

  gstId  String?
  gst    GstSetting? @relation(fields: [gstId], references: [id])

  hsnId  String?
  hsn    HsnCode? @relation(fields: [hsnId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
  sales      Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// ORDER SYSTEM
//////////////////////////////////////////////////////

model Order {
  id        String @id @default(uuid())
  userId    String

  firstName String
  lastName  String
  email     String
  phone     String

  address   String?
  city      String?
  state     String?
  country   String?
  zip       String?

  shippingCost  Float?
  orderNumber   String?
  paymentMethod String
  orderStatus   OrderStatus @default(PROCESSING)

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  sales      Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  vendorId  String

  quantity Int
  price    Float

  hsnCode     String?
  gstRate     Float?
  cgstAmount  Float?
  sgstAmount  Float?
  igstAmount  Float?
  cessAmount  Float?
  totalAmount Float?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  User    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id        String @id @default(uuid())
  orderId   String
  productId String
  vendorId  String

  total        Float
  productTitle String
  productImage String
  productPrice Float
  productQty   Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  User    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// COUPON 
//////////////////////////////////////////////////////

model Coupon {
  id         String   @id @default(uuid())
  title      String
  couponCode String
  expiryDate DateTime
  isActive   Boolean

  vendorId String
  user     User   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


//////////////////////////////////////////////////////
// SLUG TRANSLATION SYSTEM
//////////////////////////////////////////////////////

model SlugTranslation {
  id        String   @id @default(uuid())
  model     SlugModel
  entityId  String
  language  Language
  slug      String
  createdAt DateTime @default(now())

  @@unique([model, language, slug])
}

model SlugHistory {
  id        String   @id @default(uuid())
  model     SlugModel
  entityId  String
  language  Language
  oldSlug   String
  createdAt DateTime @default(now())

  @@unique([model, language, oldSlug])
}



model Banner {
  id        String   @id @default(uuid())
  title     String
  link      String
  imageUrl  String
  isActive  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
