// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 
}

enum UserRole {
  ADMIN
  USER
  SELLER
  MODERATOR
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum SlugModel {
  PRODUCT
  CATEGORY
  SUBCATEGORY
  MARKET
}

enum Language {
  EN
  HI
  MR
  TA
  TE
  KN
  GU
}

model User {
  id            String  @id @default(uuid())
  name          String?
  email         String? @unique
  password      String
  emailVerified Boolean @default(false)

  role              UserRole @default(USER)
  plan              String?
  verificationToken String?
  status            Boolean  @default(false)

  products Product[]
  coupons  Coupon[]
  orders   Order[]
  sales    Sale[]

  sellerProfile SellerProfile?
  profile       UserProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Personal Details
 
  firstName String?
  lastName  String?
  email     String?
  username  String?
  phone     String?

  // Shipping Details
  streetAddress String?
  city          String?
  country       String?
  district      String?

  dateOfBirth  DateTime?
  profileImage String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique

  code               String?
  contactPerson      String?
  contactPersonPhone String?
  profileImageUrl    String?

  firstName String?
  lastName  String?
  notes     String?

  phone           String?
  physicalAddress String?
  terms           String?

  isActive Boolean?

  

  turnover    Float?
  mainProduct String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// CATEGORY + MARKET
//////////////////////////////////////////////////////

model Category {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  imageUrl    String?
  description String?
  isActive    Boolean @default(true)

  subCategories SubCategory[]
  products      Product[]

  markets Market[] @relation("MarketCategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategory {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  imageUrl    String
  description String
  isActive    Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Market {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  logoUrl     String?
  description String?
  isActive    Boolean @default(true)

  categories Category[] @relation("MarketCategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// GST + HSN
//////////////////////////////////////////////////////

model HsnCode {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  gstRate Float? // 5, 12, 18, 28

  cgst Float?
  sgst Float?
  igst Float?

  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  description    String?
  imageUrl       String?
  productImages  String[]
  sku            String?
  barcode        String?  @unique
  productCode    String?
  unit           String?
  productPrice   Float
  salePrice      Float
  wholesalePrice Float?
  wholesaleQty   Int?
  productStock   Int?

  tags String[]

  isActive    Boolean @default(true)
  isWholesale Boolean @default(false)

  // CATEGORY
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  // VENDOR
  userId   String
  user     User   @relation(fields: [userId], references: [id])
 

  // HSN
  hsnCodeId String?
  hsnCode   HsnCode? @relation(fields: [hsnCodeId], references: [id])

  orderItems OrderItem[]
  sales      Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // personal
  firstName String
  lastName  String
  email     String
  phone     String

  // shipping
  streetAddress String?
  city          String?
  state         String?
  country       String?
  apartment     String?
  zip           String?

  shippingCost Float?

  orderNumber String @unique

  paymentMethod String

  orderStatus OrderStatus @default(PROCESSING)

  orderItems OrderItem[]

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  vendorId String

  title    String?
  imageUrl String?

  quantity Int
  price    Float

  // GST Snapshot
  hsnCode String?
  cgst    Float?
  sgst    Float?
  igst    Float?

  // QR Code
  qrCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id        String @id @default(uuid())
  orderId   String
  productId String
  vendorId  String

  total        Float
  productTitle String
  productImage String
  productPrice Float
  productQty   Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  User    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// COUPON 
//////////////////////////////////////////////////////

model Coupon {
  id         String   @id @default(uuid())
  title      String
  couponCode String
  expiryDate DateTime
  isActive   Boolean

  vendorId String
  vendor   User   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// SLUG TRANSLATION SYSTEM
//////////////////////////////////////////////////////

model SlugTranslation {
  id        String    @id @default(uuid())
  model     SlugModel
  entityId  String
  language  Language
  slug      String
  createdAt DateTime  @default(now())

  @@unique([model, language, slug])
}

model SlugHistory {
  id        String    @id @default(uuid())
  model     SlugModel
  entityId  String
  language  Language
  oldSlug   String
  createdAt DateTime  @default(now())

  @@unique([model, language, oldSlug])
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  link      String
  imageUrl  String
  isActive  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
